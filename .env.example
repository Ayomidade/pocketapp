# PocketOps Monorepo Environment Template
# Copy to server/.env and mobile/.env (never commit real secrets)

# --- Backend Server ---
PORT=4000
NODE_ENV=development
APP_BASE_URL=http://localhost:4000
MOBILE_DEEP_LINK_SCHEME=pocketops

# --- PostgreSQL & Redis ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pocketops_dev
REDIS_URL=redis://localhost:6379

# --- Security & Sessions ---
JWT_ACCESS_SECRET=replace_with_64_char_random_hex
JWT_REFRESH_SECRET=replace_with_64_char_random_hex
CREDENTIALS_ENCRYPTION_KEY=replace_with_32_byte_base64_key

# --- GitHub OAuth & GitHub App ---
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_OAUTH_CALLBACK_URL=http://localhost:4000/api/v1/auth/github/callback
GITHUB_APP_ID=your_github_app_id
GITHUB_APP_SLUG=pocketops-relay
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret

# --- Render API (Optional system default; users also connect per-account) ---
RENDER_API_BASE_URL=https://api.render.com/v1
RENDER_WEBHOOK_SECRET=your_render_webhook_secret

# --- Notifications ---
EXPO_ACCESS_TOKEN=optional_expo_push_access_token

# --- Mobile Client (Expo public variables) ---
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_APP_SCHEME=pocketops
